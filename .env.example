# ─────────────────────────────────────────────────────────────────────────
# GoFix Services CRM — environment variables
#
# Copy this file to ".env" (a plain, private copy that git will never track)
# and fill in real values. Every variable below is explained in plain
# language in README.md under "Setting up your environment file."
# ─────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------
# The connection string for your PostgreSQL database.
# During local development this comes from Neon (or Railway) — see the
# README section "Setting up the database" for step-by-step instructions.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Auth.js (staff login) -----------------------------------------------
# A random secret used to encrypt login sessions. Generate one with:
#   npx auth secret
# (this prints a value and can write it into .env for you)
AUTH_SECRET=""

# The web address this app is running at. For local development, leave as-is.
NEXTAUTH_URL="http://localhost:3000"

# --- Google Sign-In (optional, for staff login) --------------------------
# Only needed if you want the "Sign in with Google" button on the staff
# login page. Leave blank to disable it — email/password login always works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Drive (photo & document storage) ------------------------------
# These come from a Google Cloud "service account" with access to your
# GoFix Shared Drive. See README.md "Setting up Google Drive storage" for
# the full walkthrough — this is not needed until the photo-upload phase.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_SHARED_DRIVE_ID=""

# --- Stripe (payments) ----------------------------------------------------
# From your Stripe dashboard, in test mode until you're ready to go live.
# Not needed until the invoicing/payments phase.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (for magic links, quote/invoice notifications) -----------------
# Any SMTP provider works (e.g. a free Resend or Postmark account).
# Not needed for the very first local run.
EMAIL_SERVER=""
EMAIL_FROM="GoFix Services <no-reply@example.com>"
